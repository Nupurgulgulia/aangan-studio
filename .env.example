# Neon Postgres (the deployed function gets this injected automatically)
DATABASE_URL=
# Shared secret the voice agent sends as the x-api-key header
AGENT_API_KEY=
# Resend: designer handoff emails and escalation alerts
RESEND_API_KEY=
EMAIL_FROM=Aangan Studio <onboarding@resend.dev>
ESCALATION_EMAIL=
# Public dashboard URL, used for links inside emails
APP_URL=
# HubSpot private app token (scopes: crm.objects.contacts.write, crm.objects.deals.write, crm.schemas.deals.write, and the matching .read)
HUBSPOT_TOKEN=
# Vaani agent page, linked from the Chayya console
VAANI_AGENT_URL=
VAANI_API_KEY=
VAANI_AGENT_ID=
# Optional Telegram, off by default
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
