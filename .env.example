# --- App ---
APP_URL=http://localhost:3000
# Shared password for /dashboard, /review, /lead (HTTP basic auth, any username)
DASHBOARD_PASSWORD=change-me
# Vaani must send this in the x-webhook-secret header (webhook + tool endpoints)
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_WEBHOOK_SECRET=change-me
# Protects the cron endpoint (Vercel sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=change-me

# --- Neon Postgres (server side only; pooled connection string) ---
DATABASE_URL=

# --- Gemini Flash (scoring) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Resend (designer handoff + front-desk reminders) ---
RESEND_API_KEY=
EMAIL_FROM=Aangan Studio <leads@your-verified-domain.com>
FRONT_DESK_EMAIL=
# JSON array; qualified leads are assigned round-robin
DESIGNERS=[{"name":"Arjun","email":"arjun@example.com"}]

# --- Cal.com (in-call booking) ---
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CAL_FALLBACK_EMAIL_DOMAIN=noemail.aangan.invalid

# --- HubSpot (private app token; scopes: crm.objects.contacts/deals read+write) ---
HUBSPOT_TOKEN=
HUBSPOT_STAGE_NEW=appointmentscheduled
HUBSPOT_STAGE_WON=closedwon
HUBSPOT_STAGE_LOST=closedlost

# --- Cost model (dashboard warns while per-use rates are 0) ---
# Vaani: shown in the agent editor (est. per minute). Gemini 3.8 Flash paid tier: $0.75 / $3.75 per 1M
# input/output tokens until 31 Dec 2026 ($1.50 / $7.50 from 2027); INR at ~88/USD.
VAANI_COST_PER_MIN_INR=0
GEMINI_INPUT_INR_PER_M_TOKENS=0
GEMINI_OUTPUT_INR_PER_M_TOKENS=0
# Fixed monthly: Vercel + Neon + Resend + number rental etc., in INR
FIXED_MONTHLY_COST_INR=0
